# Search indexing (baked into build — set before npm run build):
#   Indexable only when GATSBY_ENV=production AND GATSBY_NOINDEX=0  ->  .env_prod_com
#   Blocked when GATSBY_NOINDEX=1 and/or GATSBY_ENV is not production  ->  dev, staging, LP
# Production robots.txt Sitemap (must be absolute URL for Google / Lighthouse SEO):
# GATSBY_SITE_URL=https://oqtima.com
GATSBY_NOINDEX=1
GATSBY_ENTITY=FSA
GATSBY_ENV=development
# Client IP detection runs on DEV, STAGING, and PRODUCTION (immediate on dev/localhost home; after LCP on prod).
# Skipped during Lighthouse/PSI audits. Localhost Lighthouse without headless UA: add ?lighthouse. Trustpilot QA in audit: ?trustpilot=1

# Homepage only: set to true or 1 to remove the Market Sentiment section (rebuild), for Lighthouse A/B vs default.
# GATSBY_DISABLE_MARKET_SENTIMENT=true
