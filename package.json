{
  "name": "website",
  "version": "2.0.1",
  "private": true,
  "description": "website",
  "author": "Catur Pamungkas",
  "keywords": [
    "gatsby"
  ],
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions",
    "not dead",
    "not ie 11"
  ],
  "scripts": {
    "start": "node scripts/clear-public-fonts.js && gatsby develop",
    "build": "npm run copy:registration-script && node scripts/gatsby-build.js",
    "build:deferred-css": "node src/scripts/build-deferred-fonts-css/index.js",
    "serve": "gatsby serve",
    "serve:perf": "node scripts/serve-static-fast.js",
    "clean": "gatsby clean",
    "copy:registration-script": "node src/scripts/copy-registration-script/index.js",
    "prebuild": "node scripts/sync-faq-bg-static.js && node scripts/sync-vps-bg-static.js && node scripts/sync-swap-free-bg-static.js && node scripts/gen-legal-faq-card-webp.js && node scripts/verify-trading-hero-webp.js && node scripts/verify-trading-tools-section-webp.js && node scripts/verify-vps-join-community-webp.js && node scripts/verify-vps-section-raster-webp.js && node scripts/verify-swap-free-raster-webp.js && node scripts/verify-mt-platform-raster-webp.js && node scripts/verify-legal-faq-card-webp.js",
    "gen:legal-faq-card-webp": "node scripts/gen-legal-faq-card-webp.js",
    "gen:swap-free-raster-webp": "node scripts/gen-swap-free-raster-webp.js",
    "gen:mt-platform-raster-webp": "node scripts/gen-mt-platform-raster-webp.js",
    "gen:all-markets-hero-webp": "node scripts/gen-all-markets-hero-webp.js",
    "gen:trading-hero-webp": "node scripts/gen-trading-hero-webp.js",
    "gen:trading-tools-section-webp": "node scripts/gen-trading-tools-section-webp.js",
    "gen:vps-join-community-webp": "node scripts/gen-vps-join-community-webp.js",
    "gen:vps-section-raster-webp": "node scripts/gen-vps-section-raster-webp.js",
    "verify:trading-hero-webp": "node scripts/verify-trading-hero-webp.js",
    "lighthouse:audit": "npx lighthouse \"http://localhost:9000/\" --only-categories=performance --preset=perf --form-factor=mobile --screenEmulation.mobile=true --output=json --output-path=./lighthouse/lighthouse-mobile-result.json --chrome-flags=\"--headless --no-sandbox\" --quiet",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:ci": "npm run build && playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.13.4",
    "axios": "^0.27.2",
    "classnames": "^2.3.1",
    "dotenv": "^16.0.1",
    "formik": "^2.2.9",
    "gatsby": "^5.9.0",
    "gatsby-plugin-config": "^1.0.7",
    "gatsby-plugin-google-tagmanager": "^5.9.0",
    "gatsby-plugin-html-attributes": "^1.0.5",
    "gatsby-plugin-image": "^3.9.0",
    "gatsby-plugin-manifest": "^5.9.0",
    "gatsby-plugin-react-i18next": "^3.0.1",
    "gatsby-plugin-sass": "^6.9.0",
    "gatsby-plugin-sharp": "^5.9.0",
    "gatsby-plugin-sitemap": "^6.9.0",
    "gatsby-source-filesystem": "^5.9.0",
    "gatsby-transformer-sharp": "^5.9.0",
    "i18next": "^22.4.15",
    "lottie-react": "^2.3.1",
    "react": "^18.1.0",
    "react-anchor-link-smooth-scroll": "^1.0.12",
    "react-device-detect": "^2.2.3",
    "react-dom": "^18.1.0",
    "react-google-recaptcha-v3": "^1.10.1",
    "react-helmet": "^6.1.0",
    "react-i18next": "^12.2.2",
    "react-intersection-observer": "^9.4.0",
    "react-native-arabic-numbers": "^1.0.1",
    "react-player": "^2.11.0",
    "react-slick": "^0.29.0",
    "react-slider": "^2.0.4",
    "react-spring": "^9.5.2",
    "react-table": "^7.8.0",
    "sass": "^1.54.3",
    "slick-carousel": "^1.8.1",
    "socket.io-client": "^4.6.1",
    "universal-cookie": "^4.0.4",
    "webpack-assets-manifest": "^5.1.0",
    "yup": "^0.32.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.6.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.32.1",
    "prettier": "^2.8.3"
  }
}
